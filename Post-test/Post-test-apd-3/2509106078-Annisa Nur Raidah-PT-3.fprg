<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="2509106078-Annisa Nur Raidah-PT-3"/>
        <attribute name="authors" value="Hype G12"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-09-30 12:35:10 AM"/>
        <attribute name="created" value="SHlwZSBHMTI7SFlQRUcxMjsyMDI1LTA5LTI3OzEyOjEyOjA5IEFNOzIzNTk="/>
        <attribute name="edited" value="SHlwZSBHMTI7SFlQRUcxMjsyMDI1LTA5LTMwOzEyOjM1OjEwIEFNOzk7MjQ2Ng=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="namapengguna, nama, paket, bronze, silver, gold, platinum" type="String" array="False" size=""/>
            <declare name="nimpengguna, nim, biayalangganan, biayaadminpaketbronze, biayaadminpaketsilver, biayaadminpaketgold, biayaadminpaketplatinum, totalhargapaketbronze, totalhargapaketsilver, totalhargapaketgold, totalhargapaketplatinum" type="Integer" array="False" size=""/>
            <assign variable="namapengguna" expression="&quot;Annisa Nur Raidah&quot;"/>
            <assign variable="nimpengguna" expression="2509106078"/>
            <assign variable="bronze" expression="&quot;bronze&quot;"/>
            <assign variable="silver" expression="&quot;silver&quot;"/>
            <assign variable="gold" expression="&quot;gold&quot;"/>
            <assign variable="platinum" expression="&quot;platinum&quot;"/>
            <assign variable="biayalangganan" expression="1500000"/>
            <assign variable="biayaadminpaketbronze" expression="biayalangganan*(1/100)"/>
            <assign variable="totalhargapaketbronze" expression="biayalangganan+biayaadminpaketbronze"/>
            <assign variable="biayaadminpaketsilver" expression="biayalangganan*(3/100)"/>
            <assign variable="totalhargapaketsilver" expression="biayalangganan+biayaadminpaketsilver"/>
            <assign variable="biayaadminpaketgold" expression="biayalangganan*(5/100)"/>
            <assign variable="totalhargapaketgold" expression="biayalangganan+biayaadminpaketgold"/>
            <assign variable="biayaadminpaketplatinum" expression="biayalangganan*(7/100)"/>
            <assign variable="totalhargapaketplatinum" expression="biayalangganan+biayaadminpaketplatinum"/>
            <output expression="&quot;=== Selamat datang di aplikasi streaming musik ===&quot;" newline="True"/>
            <output expression="&quot;Masukkan nama anda: &quot;" newline="True"/>
            <input variable="nama"/>
            <if expression="nama != namapengguna">
                <then>
                    <output expression="&quot;Error: Nama yang anda masukkan salah&quot;" newline="True"/>
                    <breakpoint expression="" always="True"/>
                </then>
                <else>
                    <output expression="&quot;Nama yang anda masukkan benar&quot;" newline="True"/>
                </else>
            </if>
            <output expression="&quot;Masukkan nim anda:&quot;" newline="True"/>
            <input variable="nim"/>
            <if expression="nim != nimpengguna">
                <then>
                    <output expression="&quot;Eror: NIM yang anda masukkan salah&quot;" newline="True"/>
                    <breakpoint expression="" always="True"/>
                </then>
                <else>
                    <output expression="&quot;NIM yang anda masukkan benar&quot;" newline="True"/>
                </else>
            </if>
            <if expression="nama == namapengguna and nim == nimpengguna">
                <then>
                    <output expression="&quot;Login berhasil&quot;" newline="True"/>
                    <output expression="&quot;Selamat datang &quot;&amp;nama &amp;&quot;, dengan NIM &quot;&amp;nim" newline="True"/>
                    <output expression="&quot;Pilihlah opsi pembayaran biaya langganaan aplikasi streaming musik&quot;" newline="True"/>
                    <output expression="&quot;Paket Bronze: Biaya administrasi 1%, akses dasar ke lagu-lagu populer&quot;" newline="True"/>
                    <output expression="&quot;Paket Silver: Biaya administrasi 3%, akses lagu premium dan playlist kustom&quot;" newline="True"/>
                    <output expression="&quot;Paket Gold: Biaya administrasi 5%, akses lagu premium, playlist kustom, dan mode offline&quot;" newline="True"/>
                    <output expression="&quot;Paket Platinum: Biaya administrasi 7%, akses semua fitur, playlist kustom, mode offline, dan konten eksklusif artis&quot;" newline="True"/>
                    <input variable="paket"/>
                    <if expression="paket == bronze">
                        <then>
                            <output expression="&quot;Jika &quot;&amp;nama &amp;&quot; membeli paket bronze, maka &quot;&amp; nama&amp;&quot; harus membayar Rp &quot;&amp; totalhargapaketbronze &amp;&quot; dengan biaya administrasi 1%. Keuntungan: akses dasar ke lagu-lagu populer&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="paket == silver">
                                <then>
                                    <output expression="&quot;Jika &quot;&amp;nama &amp;&quot; membeli paket silver, maka &quot;&amp; nama&amp;&quot; harus membayar Rp &quot;&amp; totalhargapaketsilver &amp;&quot; dengan biaya administrasi 3%. Keuntungan: akses lagu premium dan playlist kustom&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="paket == gold">
                                        <then>
                                            <output expression="&quot;Jika &quot;&amp;nama &amp;&quot; membeli paket gold, maka &quot;&amp; nama&amp;&quot; harus membayar Rp &quot;&amp; totalhargapaketgold &amp;&quot; dengan biaya administrasi 5%. Keuntungan: akses lagu premium, playlist kustom, dan mode offline&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="paket == platinum">
                                                <then>
                                                    <output expression="&quot;Jika &quot;&amp;nama &amp;&quot; membeli paket platinum, maka &quot;&amp; nama&amp;&quot; harus membayar Rp &quot;&amp; totalhargapaketplatinum &amp;&quot; dengan biaya administrasi 7%. Keuntungann: akses semua fitur, playlist kustom, mode offline, dan konten eksklusif artis&quot;" newline="True"/>
                                                </then>
                                                <else>
                                                    <output expression="&quot;Pilihan paket yang anda inginkan tidak ada&quot;" newline="True"/>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;Login gagal&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
